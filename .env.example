# Frontend
# Base URL used by the Next.js client to call the FastAPI backend.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Firebase (kept for the rest of the app shell and auth flows)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend
# FastAPI environment name.
BACKEND_ENV=development
# FastAPI host.
BACKEND_HOST=0.0.0.0
# FastAPI port.
BACKEND_PORT=8000
# Allowed frontend origins for CORS. Include local dev and production URLs.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:9002,https://your-production-frontend.example

# Databases and storage
# PostgreSQL URL used by backend services that depend on Postgres.
POSTGRES_URL=postgresql+psycopg://openmind:openmind@localhost:5432/openmind
# SQLite file for goal persistence.
GOAL_SQLITE_PATH=./.cache/openmind_goals.sqlite3
# SQLite file for memory persistence.
MEMORY_SQLITE_PATH=./.cache/openmind_memory.sqlite3
# Memory backend implementation: sqlite or memory.
MEMORY_STORE_BACKEND=sqlite

# ML / AI
# SentenceTransformer model used for embeddings and semantic search.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set true to bypass ML models with local stubs.
ENABLE_ML_STUBS=false
# Warm the embedding model on backend startup.
PRELOAD_EMBEDDING_MODEL=false
# Gemini API key used by chat, analysis, and roadmap generation.
GEMINI_API_KEY=your-gemini-api-key
# Local goal prediction model artifact.
GOAL_PREDICTION_MODEL_PATH=./app/data/goal_prediction_model.json
# Goal prediction model version label.
GOAL_PREDICTION_MODEL_VERSION=goal_predictor_v2

# Graph services
# Neo4j connection used by graph features when enabled.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
